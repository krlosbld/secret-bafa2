generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Player {
  id               String            @id @default(cuid())
  firstName        String
  code             String            @unique
  role             String            @default("STAGIAIRE") // STAGIAIRE | FORMATEUR | DIRECTEUR
  points           Int               @default(0)
  buzzCount        Int               @default(0)
  createdAt        DateTime          @default(now())
  secret           Secret?
  buzzesSent       Buzz[]            @relation("BuzzFrom")
  foundSecrets     Secret[]          @relation("FoundBy")
  evaluations      Evaluation[]
  criterionRatings CriterionRating[]

  // Panneau latéral de la page stagiaire
  personalNote          String  @default("") // écrit par le stagiaire lui-même
  ems                   String  @default("") // entretien de mi-stage
  emsVisible            Boolean @default(false)
  complementaryNote     String  @default("") // entretien complémentaire
  complementaryVisible  Boolean @default(false)
  finalAppraisal        String  @default("") // appréciation finale
  finalAppraisalVisible Boolean @default(false)
}

model Secret {
  id              String   @id @default(cuid())
  playerId        String   @unique
  content         String
  bonus           Int      @default(1)
  status          String   @default("PENDING") // PENDING | PUBLISHED | FOUND
  flagged         Boolean  @default(false)
  foundByPlayerId String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  player          Player   @relation(fields: [playerId], references: [id], onDelete: Cascade)
  foundBy         Player?  @relation("FoundBy", fields: [foundByPlayerId], references: [id])
  buzzes          Buzz[]
}

model Buzz {
  id           String   @id @default(cuid())
  secretId     String
  fromPlayerId String
  guessedName  String
  status       String   @default("PENDING") // PENDING | VALIDATED | REJECTED
  isCorrect    Boolean  @default(false)
  createdAt    DateTime @default(now())
  secret       Secret   @relation(fields: [secretId], references: [id], onDelete: Cascade)
  fromPlayer   Player   @relation("BuzzFrom", fields: [fromPlayerId], references: [id])

  @@index([secretId])
  @@index([fromPlayerId])
}

model Manager {
  id           String   @id @default(cuid())
  username     String   @unique
  passwordHash String
  createdAt    DateTime @default(now())
}

model Config {
  key   String @id
  value String
}

model PlanningBlock {
  id          String       @id @default(cuid())
  day         Int // 0 = premier jour de la formation, etc.
  startMin    Int // minutes depuis minuit
  endMin      Int
  label       String
  type        String // id du PosteType
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  evaluations Evaluation[]

  @@index([day])
}

model PosteType {
  id        String   @id @default(cuid())
  label     String
  color     String
  order     Int      @default(0)
  evaluable Boolean  @default(false)
  category  String   @default("AUTRE") // THEORIE | ANIMATION | PREPARATION | AUTRE
  createdAt DateTime @default(now())
}

model Evaluation {
  id        String        @id @default(cuid())
  playerId  String
  blockId   String
  note      String        @default("")
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt
  player    Player        @relation(fields: [playerId], references: [id], onDelete: Cascade)
  block     PlanningBlock @relation(fields: [blockId], references: [id], onDelete: Cascade)

  @@unique([playerId, blockId])
}

model Criterion {
  id        String            @id @default(cuid())
  label     String
  order     Int               @default(0)
  createdAt DateTime          @default(now())
  ratings   CriterionRating[]
}

model CriterionRating {
  id          String    @id @default(cuid())
  playerId    String
  criterionId String
  day         Int
  value       String // ACQUIS | EN_COURS | A_TRAVAILLER | NON_OBSERVE
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  player      Player    @relation(fields: [playerId], references: [id], onDelete: Cascade)
  criterion   Criterion @relation(fields: [criterionId], references: [id], onDelete: Cascade)

  @@unique([playerId, criterionId, day])
  @@index([playerId, day])
}
