generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Formation {
  id        String    @id @default(cuid())
  name      String
  code      String    @unique
  active    Boolean   @default(false)
  startDate DateTime?
  endDate   DateTime?
  location  String? // lieu de la session (facultatif)
  createdAt DateTime  @default(now())

  members           FormationMember[]
  managers          ManagerFormation[]
  invites           FormationInvite[]
  players           Player[]
  secrets           Secret[]
  planningBlocks    PlanningBlock[]
  configs           Config[]
  planningSnapshots PlanningSnapshot[]
  textEditHistory   TextEditHistory[]
  groups            Group[]
}

// Un groupe persistant de stagiaires (+ formateurs rattachés). Plusieurs groupes coexistent en
// permanence pour des travaux différents au sein d'une même formation — un stagiaire peut appartenir
// à plusieurs groupes en même temps, aucun n'est jamais écrasé par la création d'un autre.
model Group {
  id          String          @id @default(cuid())
  formationId String
  name        String
  createdAt   DateTime        @default(now())
  formation   Formation       @relation(fields: [formationId], references: [id], onDelete: Cascade)
  members     GroupMember[]
  staff       GroupStaff[]
  blocks      PlanningBlock[]

  @@index([formationId])
}

model GroupMember {
  id       String @id @default(cuid())
  groupId  String
  playerId String
  group    Group  @relation(fields: [groupId], references: [id], onDelete: Cascade)
  player   Player @relation(fields: [playerId], references: [id], onDelete: Cascade)

  @@unique([groupId, playerId])
  @@index([playerId])
}

// Formateurs/directeurs rattachés à un groupe — utilisé pour faire remonter en priorité, dans leur
// pop-up de rappel, les créneaux du planning liés à ce groupe.
model GroupStaff {
  id       String @id @default(cuid())
  groupId  String
  playerId String
  group    Group  @relation(fields: [groupId], references: [id], onDelete: Cascade)
  player   Player @relation(fields: [playerId], references: [id], onDelete: Cascade)

  @@unique([groupId, playerId])
  @@index([playerId])
}

// Historique des cases texte (évaluations, remarques, EMS, appréciation finale...) : une ligne par
// modification effective, pour pouvoir retrouver/restaurer une version précédente en cas d'écrasement
// ou de perte (comme le bug du pop-up de rappel qui remettait une case à vide).
model TextEditHistory {
  id            String    @id @default(cuid())
  formationId   String
  entityType    String // evaluation | dailyRemark | ems | retourEms | complementaryNote | finalAppraisal
  entityKey     String // clé composite selon le type (voir lib/textHistory.ts)
  previousValue String
  newValue      String
  authorId      String?
  createdAt     DateTime  @default(now())
  formation     Formation @relation(fields: [formationId], references: [id], onDelete: Cascade)

  @@index([formationId, entityType, entityKey, createdAt])
}

// Photo de l'ensemble des créneaux d'une formation à un instant donné, prise avant toute
// création/modification/suppression, pour pouvoir restaurer le planning en cas de perte.
model PlanningSnapshot {
  id          String    @id @default(cuid())
  formationId String
  blocks      String // JSON : { day, startMin, endMin, label, type }[]
  createdAt   DateTime  @default(now())
  formation   Formation @relation(fields: [formationId], references: [id], onDelete: Cascade)

  @@index([formationId, createdAt])
}

model Player {
  id                    String            @id @default(cuid())
  formationId           String
  firstName             String
  code                  String
  directorAccountId     String?
  role                  String            @default("STAGIAIRE") // STAGIAIRE | FORMATEUR | DIRECTEUR
  active                Boolean           @default(true) // false = abandon
  points                Int               @default(0)
  buzzCount             Int               @default(0)
  buzzQuotaOverride     Int? // null = utilise le quota de la formation
  isGameMaster          Boolean           @default(false) // formateur délégué par le directeur : accès admin aux secrets, ne peut pas buzzer
  createdAt             DateTime          @default(now())
  formation             Formation         @relation(fields: [formationId], references: [id], onDelete: Cascade)
  directorAccount       DirectorAccount?  @relation(fields: [directorAccountId], references: [id])
  secret                Secret?
  buzzesSent            Buzz[]            @relation("BuzzFrom")
  foundSecrets          Secret[]          @relation("FoundBy")
  evaluations           Evaluation[]
  criterionRatings      CriterionRating[]
  blockAssignments      BlockAssignment[]
  responsibleBlockStaff BlockStaff[]
  dailyRemarks          DailyRemark[]
  groupMemberships      GroupMember[]
  groupStaffRoles       GroupStaff[]
  member                FormationMember? // compte BafaPilot représenté par cette fiche, s'il y en a un

  // Panneau latéral de la page stagiaire
  personalNote              String  @default("") // écrit par le stagiaire lui-même
  ems                       String  @default("") // entretien de mi-stage
  emsVisible                Boolean @default(false)
  emsAuthorId               String? // id du formateur/directeur qui a écrit la version actuelle
  retourEms                 String  @default("") // retour suite à l'EMS
  retourEmsVisible          Boolean @default(false)
  retourEmsAuthorId         String?
  complementaryNote         String  @default("") // entretien complémentaire
  complementaryVisible      Boolean @default(false)
  complementaryNoteAuthorId String?
  finalOpinion              String  @default("EN_ATTENTE") // avis : EN_ATTENTE | FAVORABLE | DEFAVORABLE
  finalAppraisal            String  @default("") // appréciation finale
  finalAppraisalVisible     Boolean @default(false)
  finalAppraisalAuthorId    String?

  @@unique([formationId, code])
  @@index([directorAccountId])
}

model DirectorAccount {
  id           String   @id @default(cuid())
  firstName    String
  username     String   @unique
  passwordHash String
  createdAt    DateTime @default(now())
  players      Player[]
}

// ── Comptes BafaPilot ───────────────────────────────────────────────────────────────────────────
// User = identité permanente d'une personne sur BafaPilot. Player = sa représentation dans une
// formation précise (tout le BAFA Manager repose dessus). FormationMember fait le lien
// User ↔ Formation ↔ rôle ↔ Player. Les anciens accès (codes, DirectorAccount) restent en place.

model User {
  id              String    @id @default(cuid())
  firstName       String
  lastName        String
  email           String    @unique // toujours stocké en minuscules
  passwordHash    String // format auto-décrit "scrypt$..." (voir lib/password.ts)
  emailVerifiedAt DateTime?
  platformRole    String    @default("AUCUN") // AUCUN | GESTIONNAIRE | SUPERADMIN (le super-admin du .env reste en secours)
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  memberships       FormationMember[]
  managedFormations ManagerFormation[]
  sessions          UserSession[]
  authTokens        AuthToken[]
}

// Rattachement d'un compte à une formation, avec son rôle dans CETTE formation.
model FormationMember {
  id          String    @id @default(cuid())
  formationId String
  userId      String
  role        String // DIRECTEUR | FORMATEUR (texte pour pouvoir ajouter d'autres rôles)
  playerId    String?   @unique // fiche Player utilisée par le BAFA Manager pour cette personne
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  formation   Formation @relation(fields: [formationId], references: [id], onDelete: Cascade)
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  player      Player?   @relation(fields: [playerId], references: [id], onDelete: SetNull)

  @@unique([formationId, userId])
  @@index([userId])
}

// Lien d'invitation d'une session (QR code) : en l'ouvrant, on crée son compte (ou on se connecte)
// et on est rattaché automatiquement avec ce rôle. Un seul lien actif par session ; en générer un
// nouveau révoque le précédent. Le jeton figure en clair car il doit pouvoir être réaffiché/imprimé.
model FormationInvite {
  id             String    @id @default(cuid())
  formationId    String
  token          String    @unique
  role           String    @default("STAGIAIRE")
  joinCount      Int       @default(0)
  createdByLabel String
  createdAt      DateTime  @default(now())
  revokedAt      DateTime?
  formation      Formation @relation(fields: [formationId], references: [id], onDelete: Cascade)

  @@index([formationId])
}

// Formations qu'un compte GESTIONNAIRE a le droit d'administrer.
model ManagerFormation {
  id          String    @id @default(cuid())
  userId      String
  formationId String
  createdAt   DateTime  @default(now())
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  formation   Formation @relation(fields: [formationId], references: [id], onDelete: Cascade)

  @@unique([userId, formationId])
  @@index([formationId])
}

// Session de connexion : le cookie contient un jeton aléatoire opaque, seule son empreinte
// SHA-256 est stockée ici — une fuite de la base ne permet pas de se connecter.
model UserSession {
  id             String   @id @default(cuid())
  userId         String
  tokenHash      String   @unique
  expiresAt      DateTime
  lastUsedAt     DateTime @default(now())
  createdAt      DateTime @default(now())
  userAgent      String?
  // Session ouverte par un super-admin via « Se connecter en tant que » : identifiant du compte
  // super-admin, ou "LEGACY_SUPERADMIN" pour le super-admin du .env. Null = connexion normale.
  impersonatorId String?
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

// Journal des actions sensibles de l'administration (prise de contrôle d'un compte, suppression,
// changement de mot de passe, rattachements…). Les libellés sont figés au moment de l'action pour
// rester lisibles même si le compte concerné est supprimé ensuite.
model AdminAuditLog {
  id           String   @id @default(cuid())
  actorUserId  String? // null = super-admin du .env
  actorLabel   String
  action       String
  targetUserId String?
  targetLabel  String?
  formationId  String?
  details      String?
  createdAt    DateTime @default(now())

  @@index([createdAt])
  @@index([targetUserId])
}

// Jetons à usage unique envoyés par email (confirmation d'adresse, mot de passe oublié) :
// seule l'empreinte est stockée, usedAt les rend inutilisables une fois consommés.
model AuthToken {
  id        String    @id @default(cuid())
  userId    String
  type      String // VERIFY_EMAIL | RESET_PASSWORD
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, type])
}

model Secret {
  id                       String    @id @default(cuid())
  formationId              String
  playerId                 String    @unique
  content                  String
  bonus                    Int       @default(1)
  status                   String    @default("PENDING") // PENDING | PUBLISHED | FOUND
  flagged                  Boolean   @default(false)
  isDecoy                  Boolean   @default(false) // faux secret créé par l'admin, sans vrai joueur derrière
  limitedVisibility        Boolean   @default(false)
  limitedVisibilitySince   DateTime? // instant d'activation — ancre le cycle horaire
  limitedVisibilityMinutes Int       @default(5) // durée visible par heure, choisie par l'admin
  foundByPlayerId          String?
  createdAt                DateTime  @default(now())
  updatedAt                DateTime  @updatedAt
  formation                Formation @relation(fields: [formationId], references: [id], onDelete: Cascade)
  player                   Player    @relation(fields: [playerId], references: [id], onDelete: Cascade)
  foundBy                  Player?   @relation("FoundBy", fields: [foundByPlayerId], references: [id])
  buzzes                   Buzz[]

  @@index([formationId])
}

model Buzz {
  id           String   @id @default(cuid())
  secretId     String
  fromPlayerId String
  guessedName  String
  status       String   @default("PENDING") // PENDING | VALIDATED | REJECTED
  isCorrect    Boolean  @default(false)
  createdAt    DateTime @default(now())
  secret       Secret   @relation(fields: [secretId], references: [id], onDelete: Cascade)
  fromPlayer   Player   @relation("BuzzFrom", fields: [fromPlayerId], references: [id])

  @@index([secretId])
  @@index([fromPlayerId])
}

model Manager {
  id           String   @id @default(cuid())
  username     String   @unique
  passwordHash String
  createdAt    DateTime @default(now())
}

model Config {
  id          String    @id @default(cuid())
  formationId String
  key         String
  value       String
  formation   Formation @relation(fields: [formationId], references: [id], onDelete: Cascade)

  @@unique([formationId, key])
}

model PlanningBlock {
  id               String            @id @default(cuid())
  formationId      String
  day              Int // 0 = premier jour de la formation, etc.
  startMin         Int // minutes depuis minuit
  endMin           Int
  label            String
  type             String // id du PosteType
  groupId          String? // groupe rattaché — ses formateurs voient ce créneau en priorité dans le pop-up
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  formation        Formation         @relation(fields: [formationId], references: [id], onDelete: Cascade)
  responsibleStaff BlockStaff[] // formateurs/directeurs à relancer pour saisir les retours une fois le créneau passé
  group            Group?            @relation(fields: [groupId], references: [id], onDelete: SetNull)
  evaluations      Evaluation[]
  assignments      BlockAssignment[]

  @@index([day])
  @@index([formationId])
}

// Formateurs/directeurs responsables d'un créneau — plusieurs possibles par créneau, chacun voit ce
// créneau dans son pop-up de rappel une fois passé.
model BlockStaff {
  id       String        @id @default(cuid())
  blockId  String
  playerId String
  block    PlanningBlock @relation(fields: [blockId], references: [id], onDelete: Cascade)
  player   Player        @relation(fields: [playerId], references: [id], onDelete: Cascade)

  @@unique([blockId, playerId])
  @@index([playerId])
}

model BlockAssignment {
  id        String        @id @default(cuid())
  blockId   String
  playerId  String
  createdAt DateTime      @default(now())
  block     PlanningBlock @relation(fields: [blockId], references: [id], onDelete: Cascade)
  player    Player        @relation(fields: [playerId], references: [id], onDelete: Cascade)

  @@unique([blockId, playerId])
  @@index([blockId])
}

model PosteType {
  id             String   @id @default(cuid())
  label          String
  color          String
  order          Int      @default(0)
  evaluable      Boolean  @default(false)
  category       String   @default("AUTRE") // THEORIE | ANIMATION | AUTRE | THEMATIQUE | RETOUR_STAGE
  countedInHours Boolean  @default(true)
  createdAt      DateTime @default(now())
}

model Evaluation {
  id        String        @id @default(cuid())
  playerId  String
  blockId   String
  note      String        @default("")
  authorId  String? // id du formateur/directeur qui a écrit la version actuelle
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt
  player    Player        @relation(fields: [playerId], references: [id], onDelete: Cascade)
  block     PlanningBlock @relation(fields: [blockId], references: [id], onDelete: Cascade)

  @@unique([playerId, blockId])
}

model Criterion {
  id        String            @id @default(cuid())
  label     String
  order     Int               @default(0)
  createdAt DateTime          @default(now())
  ratings   CriterionRating[]
}

model CriterionRating {
  id          String    @id @default(cuid())
  playerId    String
  criterionId String
  day         Int
  value       String // id d'un CriterionState
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  player      Player    @relation(fields: [playerId], references: [id], onDelete: Cascade)
  criterion   Criterion @relation(fields: [criterionId], references: [id], onDelete: Cascade)

  @@unique([playerId, criterionId, day])
  @@index([playerId, day])
}

model DailyRemark {
  id        String   @id @default(cuid())
  playerId  String
  day       Int
  note      String   @default("")
  authorId  String? // id du formateur/directeur qui a écrit la version actuelle
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  player    Player   @relation(fields: [playerId], references: [id], onDelete: Cascade)

  @@unique([playerId, day])
}

model CriterionState {
  id        String   @id @default(cuid())
  label     String
  color     String
  score     Float? // -1..1, null = exclu du calcul de tendance
  order     Int      @default(0)
  createdAt DateTime @default(now())
}
